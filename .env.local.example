# Turso データベース設定
# Turso (https://turso.tech) でデータベースを作成後、以下を設定してください
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Auth.js 設定（本番では openssl rand -base64 32 等で生成した強い値を使用）
AUTH_SECRET=your-auth-secret-here

# バックアップ暗号化（推奨）
# scripts/backup.ts と自動バックアップ（/api/cron/backup → Vercel Blob）は
# この環境変数があれば AES-256-GCM で暗号化保存する。
# 未設定の場合は警告して平文保存される。
# Vercel 環境には設定済み。ローカルは `vercel env pull` で取得できる。
BACKUP_ENCRYPTION_KEY=

# Vercel Cron 認証（本番のみ。Vercel が Authorization: Bearer で送る）
CRON_SECRET=

# Vercel Blob（自動バックアップの保存先。ストア接続時に自動設定される）
BLOB_READ_WRITE_TOKEN=

# Sentry エラー監視（任意）
# 未設定なら Sentry は呼ばれない（no-op）
# サーバー側 DSN
SENTRY_DSN=
# クライアント側 DSN（同じ値で OK、ブラウザに露出する）
NEXT_PUBLIC_SENTRY_DSN=
